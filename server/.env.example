# Copy to .env and fill in. Leave the two API keys empty to run in demo mode.
PORT=4000
# Any long random string. The phone app must use the same value (Settings > Access token).
APP_TOKEN=change-me-to-a-long-random-string
# https://elevenlabs.io/app/settings/api-keys  (speech-to-text with speaker labels)
ELEVENLABS_API_KEY=
# https://console.anthropic.com/settings/keys  (Claude writes the report)
ANTHROPIC_API_KEY=
# Optional: words the transcriber should listen for, comma-separated
KEYTERMS=
# Where recordings and the database are stored
DATA_DIR=./data
# Live captions: main language and others expected in the same meeting (ISO codes)
LIVE_LANGUAGE=ms
LIVE_SECONDARY_LANGUAGES=en
