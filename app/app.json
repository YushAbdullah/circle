{
  "expo": {
    "name": "CIRCLE",
    "slug": "circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yushabdullah.circle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3F8E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yushabdullah.circle"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "CIRCLE",
      "shortName": "CIRCLE",
      "themeColor": "#F6FEF6",
      "backgroundColor": "#F6FEF6"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow CIRCLE to record your meetings.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "circle",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "owner": "yushabdullah",
    "extra": {
      "eas": {
        "projectId": "c226bf09-16bf-4c03-a19f-457afee09005"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c226bf09-16bf-4c03-a19f-457afee09005"
    }
  }
}
